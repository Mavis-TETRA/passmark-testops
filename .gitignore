
# Dependencies and package-manager caches
/node_modules/
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/

# Environment files
.env
.env.*
!.env.example

# Build output and tool caches
/public/
/dist/
/build/
/coverage/
.vite/
.cache/
*.tsbuildinfo
.eslintcache

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Playwright output
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# Generated test specs
/tests/generated-*.spec.ts
/tests/imported-testcases-*.spec.ts

# Local database and runtime storage
/storage/
*.db
*.sqlite
*.sqlite3

# Docker/local machine data
/.docker/

# Temporary process files
*.pid
*.pid.lock
*.tmp
*.temp

# OS and editor files
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
