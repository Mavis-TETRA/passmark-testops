PORT=5000
PASSMARK_CAPTURE_PASSED_SCREENSHOTS=true
PASSMARK_CONTAINERIZED=false
# Optional. If empty, Passmark creates a persistent local key in storage/passmark-secret.key.
PASSMARK_SECRET_KEY=
DATABASE_URL=postgresql://passmark:passmark@localhost:5432/passmark
LOCAL_AI_PROVIDER=ollama
LOCAL_AI_BASE_URL=http://localhost:11434
LOCAL_AI_API_KEY=ollama
LOCAL_AI_MODEL=qwen2.5-coder:1.5b
LOCAL_AI_TIMEOUT_MS=180000
LOCAL_AI_MAX_TOKENS=768
LOCAL_AI_CONTEXT_TOKENS=2048
LOCAL_AI_NUM_THREAD=2
LOCAL_AI_TEMPERATURE=0.2
LOCAL_AI_KEEP_ALIVE=1m
LOCAL_AI_CASES_PER_BATCH=2
LOCAL_AI_BATCH_TIMEOUT_MS=90000
LOCAL_AI_BATCH_MAX_TOKENS=512
